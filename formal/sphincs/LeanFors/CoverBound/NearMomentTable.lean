/-- Upper bounds of `ΨH(n)`, `n ≤ 150`. -/
def PHtab : List ℚ := PHL.map fun x : ℕ => (x : ℚ) / 2 ^ 128

omit [Params] in
theorem PHL_eq : PHL.map (fun x : ℕ => (x : ℚ) / 2 ^ 128) = PHtab := rfl

theorem PHtab_eq : (List.range 151).map PHQ = PHtab := by
  rw [map_range_eq (by rw [PHNL, List.length_map, List.length_range]) PHQ_eq]
  decide +kernel

theorem ΨHR_le_tab (j : SubIdx) (n : ℕ) (hn : n ≤ 150) : ΨHR j n ≤ (PHtab.getD n 0 : ℝ) := by
  rw [← PHtab_eq, getD_map_range PHQ 0 151 n (by omega)]
  exact ΨHR_le j n hn

end LeanFors.Security.H0
