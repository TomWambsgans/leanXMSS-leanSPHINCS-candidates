import LeanFors.CoverBound.MomentBounds
import LeanFors.CoverBound.NearMoment

/-! **The half-cover moment table, checked by the kernel.** Upper bounds of `ΨH(n)` for `n ≤ 150`
(generated by `scripts/forest_table.py`). The kernel computes their numerators over `2^128` in `ℕ`
(`PHNL`) and compares the quotients with the table, given by its numerators `PHL` over `2^128` (which
`Certificates/Build.lean` reads). -/

namespace LeanFors.Security.H0

variable [Params]

open Concrete LeanFors.Base.H0

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

/-- The bound of `ΨH(n)`. -/
def PHQ (n : ℕ) : ℚ :=
  rup (((List.range (n + 1)).map fun i => binQ n i (1 / 16) (15 / 16) * μL.getD i 0).sum) 128

/-- **The half-cover moment bound.** -/
theorem ΨHR_le (j : SubIdx) (n : ℕ) (hn : n ≤ 150) : ΨHR j n ≤ (PHQ n : ℝ) := by
  rw [ΨHR_eq]
  unfold PHQ
  refine rup_ge_real ?_ 128
  rw [list_sum_range]
  push_cast
  refine Finset.sum_le_sum fun i hi => ?_
  have hi' := Finset.mem_range.1 hi
  rw [binQ_cast, μL_getD i (by omega)]
  push_cast
  have h1 := μR_bounds i
  gcongr
  exact h1.2

theorem ΨHR_nonneg (j : SubIdx) (n : ℕ) : 0 ≤ ΨHR j n := avgNR_nonneg (coverHAvg_nonneg j) n 0

/-- The numerators of `PHQ` over `2^128`. -/
def PHNL : List ℕ := (List.range 151).map fun n => cdiv (binN 15 n μNL) (2 ^ (4 * n))

theorem PHQ_eq (n : ℕ) (hn : n ≤ 150) : PHQ n = (PHNL.getD n 0 : ℚ) / 2 ^ 128 := by
  rw [PHNL, getD_map_range _ _ _ _ (by omega), PHQ, list_sum_range,
    binQ_sum_list 4 15 n 128 μNL (fun i => μL.getD i 0) (1 / 16) (15 / 16) (by norm_num) (by norm_num)
      (fun i hi => by rw [μL_getD i (by omega), μQ_eq i (by omega)]),
    rup_dyadic _ _ (by omega), show 4 * n + 128 - 128 = 4 * n by omega]

