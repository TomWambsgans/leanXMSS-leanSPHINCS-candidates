/-! ### The codeword-level sums are probabilities -/

theorem Hm_nonneg (m : FChain → FPos) : 0 ≤ Hm m := by
  unfold Hm avgR
  exact mul_nonneg (inv_nonneg.2 (Nat.cast_nonneg _)) (Finset.sum_nonneg fun w _ => by split_ifs <;> norm_num)

theorem Hm_le_one (m : FChain → FPos) : Hm m ≤ 1 := by
  unfold Hm
  calc (avgR fun w : LutIdx => if ∀ i, (lut w i).val ≤ (m i).val then (1 : ℝ) else 0)
      ≤ avgR fun _ : LutIdx => (1 : ℝ) := by
        unfold avgR
        exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun w _ => by split_ifs <;> norm_num)
          (inv_nonneg.2 (Nat.cast_nonneg _))
    _ = 1 := avgR_const 1

theorem avgR_mem_unit {α : Type} [Fintype α] [Nonempty α] (g : α → ℝ) (h0 : ∀ a, 0 ≤ g a) (h1 : ∀ a, g a ≤ 1) :
    0 ≤ avgR g ∧ avgR g ≤ 1 := by
  unfold avgR
  have hc : (0 : ℝ) < Fintype.card α := by exact_mod_cast Fintype.card_pos
  refine ⟨mul_nonneg (inv_nonneg.2 hc.le) (Finset.sum_nonneg fun a _ => h0 a), ?_⟩
  calc (Fintype.card α : ℝ)⁻¹ * ∑ a, g a ≤ (Fintype.card α : ℝ)⁻¹ * ∑ _a : α, (1 : ℝ) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun a _ => h1 a) (inv_nonneg.2 hc.le)
    _ = 1 := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, inv_mul_cancel₀ hc.ne']

theorem fR_unit (u : ℕ) : 0 ≤ fR u ∧ fR u ≤ 1 := by
  rw [fR_eq_max]
  exact avgR_mem_unit _ (fun c => Hm_nonneg _) (fun c => Hm_le_one _)

theorem f2R_unit (u : ℕ) : 0 ≤ f2R u ∧ f2R u ≤ 1 := by
  rw [f2R_eq_max]
  exact avgR_mem_unit _ (fun c => sq_nonneg _) (fun c => pow_le_one₀ (Hm_nonneg _) (Hm_le_one _))

/-! ### Packing a list into one integer -/

/-- The packing base: every numerator lies in `[0, packB)`. -/
def packB : ℕ := 2 ^ 340

theorem packB_gt : 256 ^ 42 < packB := by decide +kernel

/-- A list read as the digits of an integer in base `packB`, least significant first. -/
def evB : List ℤ → ℤ
  | [] => 0
  | a :: l => a + packB * evB l

theorem evB_zipWith_add : ∀ (l l' : List ℤ), l.length = l'.length →
    evB (List.zipWith (· + ·) l l') = evB l + evB l'
  | [], [], _ => rfl
  | a :: l, b :: l', h => by
      simp only [List.zipWith_cons_cons, evB]
      rw [evB_zipWith_add l l' (by simpa using h)]
      ring
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem evB_map_range (f : ℕ → ℤ) : ∀ n, evB ((List.range n).map f) = ∑ u ∈ range n, f u * packB ^ u
  | 0 => rfl
  | n + 1 => by
      rw [List.range_succ_eq_map, List.map_cons, List.map_map, evB, evB_map_range, sum_range_succ', mul_sum,
        pow_zero, mul_one, add_comm]
      exact congrArg (· + f 0) (sum_congr rfl fun u _ => by simp only [Function.comp_apply]; ring)

/-- Summed over the grid, the digits of `k^u dk`, `u ≤ U`, are `dk Σ_u (k packB)^u`. -/
theorem evB_sumTL (U : ℕ) : ∀ (d : ℕ) (a b : NT d),
    evB (sumTL d (powsL U) a b) = sumT2 d (fun k dk => dk * ∑ u ∈ range (U + 1), (k * packB) ^ u) a b
  | 0, a, b => by
      simp only [sumTL, sumT2, powsL]
      rw [evB_map_range, mul_sum]
      exact sum_congr rfl fun u _ => by ring
  | d + 1, a, b => by
      simp only [sumTL, sumT2]
      rw [evB_zipWith_add _ _ (by simp [List.length_zipWith, length_sumTL]),
        evB_zipWith_add _ _ (by simp [List.length_zipWith, length_sumTL]),
        evB_zipWith_add _ _ (by simp [List.length_zipWith, length_sumTL]),
        evB_zipWith_add _ _ (by simp [length_sumTL])]
      simp only [evB_sumTL U d]

/-- Digits in `[0, packB)` are determined by the integer they spell. -/
theorem eq_of_evB_eq : ∀ (l l' : List ℤ), l.length = l'.length → (∀ x ∈ l, 0 ≤ x ∧ x < packB) →
    (∀ x ∈ l', 0 ≤ x ∧ x < packB) → evB l = evB l' → l = l'
  | [], [], _, _, _, _ => rfl
  | a :: l, b :: l', hlen, hl, hl', he => by
      simp only [evB] at he
      obtain ⟨ha0, ha1⟩ := hl a (by simp)
      obtain ⟨hb0, hb1⟩ := hl' b (by simp)
      have hB : (0 : ℤ) < packB := by have := packB_gt; omega
      have hx : evB l = evB l' := by
        rcases lt_trichotomy (evB l) (evB l') with h | h | h
        · nlinarith
        · exact h
        · nlinarith
      rw [hx] at he
      obtain rfl : a = b := by linarith
      rw [eq_of_evB_eq l l' (by simpa using hlen) (fun x hx => hl x (by simp [hx]))
        (fun x hx => hl' x (by simp [hx])) hx]
  | [], _ :: _, h, _, _, _ => by simp at h
  | _ :: _, [], h, _, _, _ => by simp at h

/-- `Σ_{u ≤ U} (x packB)^u` in closed form. -/
def geomN (U x : ℕ) : ℕ := if x = 0 then 1 else ((x * packB) ^ (U + 1) - 1) / (x * packB - 1)

theorem geomN_eq (U x : ℕ) : geomN U x = ∑ u ∈ range (U + 1), (x * packB) ^ u := by
  unfold geomN
  split_ifs with hx
  · subst hx
    rw [sum_range_succ']
    simp
  · rw [Nat.geomSum_eq]
    have : 1 ≤ x := Nat.pos_of_ne_zero hx
    calc 2 ≤ packB := by have := packB_gt; omega
      _ ≤ x * packB := Nat.le_mul_of_pos_left _ this

/-! ### The kernel checks -/

theorem KT_nonneg (m : FChain → FPos) : 0 ≤ getT childChains KT m := by
  have h := getT_KT m
  have := Hm_nonneg m
  have : (0 : ℝ) ≤ getT childChains KT m := by rw [h]; positivity
  exact_mod_cast this

/-- On the CDF counts the geometric sums are the closed forms `geomN`. -/
theorem sumT2_geomN (D : NT childChains) :
    sumT2 childChains (fun k dk => dk * ∑ u ∈ range 41, (k * packB) ^ u) KT D =
      sumT2 childChains (fun k dk => dk * (geomN 40 k.toNat : ℤ)) KT D := by
  have h := sumT2_eq (fun k dk => dk * ∑ u ∈ range 41, (k * packB) ^ u) childChains KT D
  have h' := sumT2_eq (fun k dk => dk * (geomN 40 k.toNat : ℤ)) childChains KT D
  have e : (sumT2 childChains (fun k dk => dk * ∑ u ∈ range 41, (k * packB) ^ u) KT D : ℝ) =
      sumT2 childChains (fun k dk => dk * (geomN 40 k.toNat : ℤ)) KT D := by
    rw [h, h']
    refine sum_congr rfl fun m _ => congrArg Int.cast ?_
    show getT childChains D m * _ = getT childChains D m * _
    rw [geomN_eq, Nat.cast_sum]
    simp only [Nat.cast_pow, Nat.cast_mul, Int.toNat_of_nonneg (KT_nonneg m)]
  exact_mod_cast e

/-- The numerators lie in `[0, packB)`. -/
theorem sumTL_mem {D : NT childChains} {c : ℕ}
    (hD : ∀ u ≤ 40, 0 ≤ sumT2 childChains (fun k dk => k ^ u * dk) KT D ∧
      sumT2 childChains (fun k dk => k ^ u * dk) KT D ≤ 256 ^ (u + c)) (hc : c ≤ 2) :
    ∀ x ∈ sumTL childChains (powsL 40) KT D, 0 ≤ x ∧ x < packB := by
  intro x hx
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
  have hi' : i ≤ 40 := by rw [length_sumTL] at hi; omega
  rw [← List.getD_eq_getElem _ 0 hi, getD_sumTL 40 i hi']
  obtain ⟨h0, h1⟩ := hD i hi'
  refine ⟨h0, h1.trans_lt ?_⟩
  calc (256 : ℤ) ^ (i + c) ≤ 256 ^ 42 := pow_le_pow_right₀ (by norm_num) (by omega)
    _ < packB := by exact_mod_cast packB_gt

theorem fNum_mem (u : ℕ) : 0 ≤ fNum u ∧ fNum u ≤ 256 ^ (u + 1) := by
  have h := fR_unit u
  rw [fR_num] at h
  have hp : (0 : ℝ) < 256 ^ (u + 1) := by positivity
  rw [le_div_iff₀ hp, zero_mul, div_le_one hp] at h
  exact ⟨by exact_mod_cast h.1, by exact_mod_cast h.2⟩

theorem f2Num_mem (u : ℕ) : 0 ≤ f2Num u ∧ f2Num u ≤ 256 ^ (u + 2) := by
  have h := f2R_unit u
  rw [f2R_num] at h
  have hp : (0 : ℝ) < 256 ^ (u + 2) := by positivity
  rw [le_div_iff₀ hp, zero_mul, div_le_one hp] at h
  exact ⟨by exact_mod_cast h.1, by exact_mod_cast h.2⟩

/-- The packed numerators of `f`, by the kernel. -/
theorem fPack : sumT2 childChains (fun k dk => dk * (geomN 40 k.toNat : ℤ)) KT DK = evB fTab := by
  decide +kernel

/-- The packed numerators of `f2`, by the kernel. -/
theorem f2Pack : sumT2 childChains (fun k dk => dk * (geomN 40 k.toNat : ℤ)) KT DK2 = evB f2Tab := by
  decide +kernel

theorem fTab_eq : sumTL LeanForest.childChains (powsL 40) KT DK = fTab :=
  eq_of_evB_eq _ _ (by rw [length_sumTL]; rfl) (sumTL_mem (fun u _ => fNum_mem u) (by norm_num))
    (by decide +kernel) (by rw [evB_sumTL, sumT2_geomN, fPack])

theorem f2Tab_eq : sumTL LeanForest.childChains (powsL 40) KT DK2 = f2Tab :=
  eq_of_evB_eq _ _ (by rw [length_sumTL]; rfl) (sumTL_mem (fun u _ => f2Num_mem u) le_rfl)
    (by decide +kernel) (by rw [evB_sumTL, sumT2_geomN, f2Pack])

end LeanForest.Security.H0
